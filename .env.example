# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL (used by docker-compose and the backend)
POSTGRES_DB=vapt_report_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# pgAdmin (optional, docker-compose only)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# SQLAlchemy connection string
DATABASE_URL=postgresql+psycopg2://postgres:change-me@localhost:5432/vapt_report_db

# Auth / JWT
SECRET_KEY=generate-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Gemini (AI-assisted content generation)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
